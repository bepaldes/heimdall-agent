{
  "description": "Heimdall Sentinel Lifecycle Hooks for Claude Code and AI Harnesses",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOOKS_DIR}}/heimdall-hook.cjs\" pre-bash"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOOKS_DIR}}/heimdall-hook.cjs\" pre-write"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOOKS_DIR}}/heimdall-hook.cjs\" pre-compact"
          }
        ]
      }
    ]
  }
}
